# Copy to .env (never commit .env). See docs/architecture §17.
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000
ADMIN_URL_PREFIX=admin
DATABASE_URL=postgres://viewnet:viewnet@postgres:5432/viewnet
REDIS_CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
LOG_LEVEL=INFO

OTP_HMAC_PEPPER=generate-a-separate-long-random-string
SMS_PROVIDER=console
SMS_FALLBACK_PROVIDER=
NUM_PROXIES=0

CART_MAX_QTY_PER_ITEM=10
STOCK_RESERVATION_TTL_MINUTES=30
